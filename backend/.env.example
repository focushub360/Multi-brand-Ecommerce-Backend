# ==============================================================================
# GROVE Multi-Brand E-Commerce Backend Environment Configuration
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/grove_ecommerce

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Super Admin Initial Bootstrap Credentials
ADMIN_NAME=GROVE Super Admin
ADMIN_EMAIL=admin@grove.com
ADMIN_PASSWORD=Admin@123

# Email Service (Nodemailer SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GROVE Platform Support <support@grove.com>"

